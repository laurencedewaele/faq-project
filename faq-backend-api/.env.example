# Configuration de l'API FAQ
# Copier ce fichier en .env et remplir les valeurs

# Modèle d'embedding à utiliser
# Options: "intfloat/multilingual-e5-small" (par défaut), "intfloat/multilingual-e5-base", etc.
MODEL_NAME=intfloat/multilingual-e5-small

# Nom de la collection ChromaDB utilisée pour l'indexation
CHROMA_COLLECTION_NAME=faq

# Seuil de confiance pour retourner une réponse (0.0 à 1.0)
# 0.5 par défaut - à augmenter pour être plus strict, réduire pour être plus permissif
SIMILARITY_THRESHOLD=0.85

# Nombre maximum de candidats distincts à considérer
TOP_K=3

# Modèle Cross-Encoder utilisé pour le reranking
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2

# Seuil de différence relative entre le meilleur et le deuxième candidat
CROSS_ENCODER_GAP_THRESHOLD=0.10

# Seuil minimum du score Cross-Encoder pour conserver un seul candidat
CROSS_ENCODER_CONFIDENCE_THRESHOLD=0.60
