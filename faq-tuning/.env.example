# Copier ce fichier en .env pour lancer langsmith_evaluate.py

# Cle API LangSmith (Settings > API Keys dans l'app LangSmith)
LANGSMITH_API_KEY=lsv2_pt_xxx

# Endpoint : commenter si le compte est sur la region US
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Projet de tracing (surcharge par --project a l'execution)
LANGSMITH_PROJECT=faq-evaluate
